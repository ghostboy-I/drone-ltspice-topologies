# LTspice outputs (regenerated by running the simulations; .raw files are up to 1.7 GB)
*.raw
*.log
*.net
*.db
*.db-journal
*.fft
*.plt
# Python cache
__pycache__/
*.pyc

# Agent worktrees (Claude desktop sessions, Parallel Code)
.claude/worktrees/
.worktrees/

# Local agent coordinator runtime files
orchestrator/queue/
orchestrator/state/
orchestrator/logs/

# Sweep case folders (regenerated by tools/sweep.py); results.csv and plots stay tracked
**/sweeps/*/case_*/

# Prop project: locally unpacked XFOIL binary and shim (re-created by tools/get_xfoil.sh), XFOIL polar cache
Props/*/tools/xfoil_pkg/
Props/*/tools/*.so
# Prop project: large generated CAD/mesh files (re-created by `make geometry`)
Props/*/geometry/*.stl
Props/*/geometry/*.step
Props/*/geometry/*.geo
