TEXT 32 -500 Left 2 ; === 06  BEC: 4S -> 5 V / 3 A SYNCHRONOUS BUCK, voltage mode, Type-III compensation, input feed-forward  (SWITCHING model, transients) ===
TEXT 32 -470 Left 2 !.param Vin=15.2 Lout=6.8e-06 DCR=0.015 Cout=3.96e-05 ESR=0.001667 Cin=1e-05 KFF=10.0
TEXT 32 -440 Left 2 !.param Vref=0.8 Rtop=5.23e+04 Rbot=1e+04 R2=1.87e+04 C1=1.8e-09 C2=3.3e-11 R3=1430 C3=4.7e-10
TEXT 32 -410 Left 2 !.param gm=1m A0=10k GBW=10Meg      ; error amplifier: 80 dB DC gain, 10 MHz gain-bandwidth
TEXT 32 -380 Left 2 !.param Fsw=5e+05 Tsw={1/Fsw} Tdead=20n dband={Tdead/Tsw} Dmax=0.9 Vdrv=5 RgH=10 RgL=1   ; slow high-side turn-on, stiff low-side hold-off (first run, 2 ohm both: shoot-through)
TEXT 32 -350 Left 2 !.param Fff=100k        ; feed-forward Vin sense filter (removes switching spikes from the ramp amplitude)
TEXT 32 -320 Left 2 !.param Tss=1m Ilo=0.5 Ihi=3 Tst1=1.5m Tst2=2.2m Tst3=2.6m
TEXT 32 -290 Left 2 !.param Fesc=48k Vrip=1.5 Trip=2.9m Tsag=3.5m Vsag=0.8     ; ESC bus disturbances seen in topology 04
TEXT 32 -260 Left 2 !.step param FF list 1 0     ; input-voltage feed-forward on / off
TEXT 32 -230 Left 2 !.model BUCK_FET VDMOS(Rd=3m Rs=1m Vto=1.6 Kp=60 Cgdmax=400p Cgdmin=60p Cgs=900p Cjo=500p Is=2p N=1.05 Rb=6m Tt=10n Vds=30 Ron=6m Qg=10n mfg=Learning)
