Version 4
SHEET 1 2400 1600
SYMBOL voltage 64 96 R0
SYMATTR InstName Vbat
SYMATTR Value {Pol*Vb}
FLAG 64 112 braw
FLAG 64 192 0
SYMBOL res 176 80 R0
SYMATTR InstName Rint
SYMATTR Value {Rbatt}
FLAG 192 96 braw
FLAG 192 176 bt
SYMBOL bi 320 96 R0
SYMATTR InstName B_MAIN
SYMATTR Value I=V(bt,hp)*({Gon}*(1+tanh((time-{Tmain})/{Tc}))/2+1e-9)
FLAG 320 96 bt
FLAG 320 176 hp
SYMBOL bi 448 96 R0
SYMATTR InstName B_PRE
SYMATTR Value I=V(bt,hp)*{Pre}/{Rpre}*(1+tanh((time-{Tplug})/{Tc}))/2
FLAG 448 96 bt
FLAG 448 176 hp
SYMBOL ind 560 80 R0
SYMATTR InstName Lpos
SYMATTR Value {Lloop/2}
SYMATTR SpiceLine Rser={Rloop/2}
FLAG 576 96 hp
FLAG 576 176 bus
SYMBOL ind 688 80 R0
SYMATTR InstName Lneg
SYMATTR Value {Lloop/2}
SYMATTR SpiceLine Rser={Rloop/2}
FLAG 704 96 0
FLAG 704 176 hn
SYMBOL nmos 880 96 R0
SYMATTR InstName MQ1
SYMATTR Value PROT_FET
FLAG 928 96 hn
FLAG 880 176 gt
FLAG 928 192 s
SYMBOL nmos 1040 96 R0
SYMATTR InstName MQ2
SYMATTR Value PROT_FET
FLAG 1088 96 g
FLAG 1040 176 gt
FLAG 1088 192 s
SYMBOL res 1184 80 R0
SYMATTR InstName Rbyp
SYMATTR Value {if(Prot,1G,0.1m)}
FLAG 1200 96 hn
FLAG 1200 176 g
SYMBOL res 1312 80 R0
SYMATTR InstName Rg
SYMATTR Value {Rgate}
FLAG 1328 96 bus
FLAG 1328 176 gt
SYMBOL cap 1440 96 R0
SYMATTR InstName Cm
SYMATTR Value {Cmiller}
FLAG 1456 96 gt
FLAG 1456 160 g
SYMBOL res 1568 80 R0
SYMATTR InstName Rgs
SYMATTR Value 100k
FLAG 1584 96 gt
FLAG 1584 176 s
SYMBOL diode 1696 96 R0
SYMATTR InstName Dz
SYMATTR Value DZ12
FLAG 1712 96 s
FLAG 1712 160 gt
SYMBOL cap 1776 96 R0
SYMATTR InstName Cgsx
SYMATTR Value {Cgsx}
FLAG 1792 96 gt
FLAG 1792 160 s
SYMBOL cap 1856 96 R0
SYMATTR InstName Ccer
SYMATTR Value 10u
SYMATTR SpiceLine Rser=2m Lser=2n
FLAG 1872 96 bus
FLAG 1872 160 g
SYMBOL cap 1984 96 R0
SYMATTR InstName Cbulk
SYMATTR Value 470u
SYMATTR SpiceLine Rser=30m Lser=10n
FLAG 2000 96 bus
FLAG 2000 160 g
SYMBOL diode 2112 96 R0
SYMATTR InstName Desc
SYMATTR Value ESC_BODY
FLAG 2128 96 g
FLAG 2128 160 bus
SYMBOL bi 2240 96 R0
SYMATTR InstName B_LOAD
SYMATTR Value I=V(pload)/max(V(bus,g),9)*(1+tanh(4*(V(bus,g)-9)))/2
FLAG 2240 96 bus
FLAG 2240 176 g
SYMBOL voltage 2240 336 R0
SYMATTR InstName Vpload
SYMATTR Value PWL(0 0 {Ton} 0 {Ton+5m} {P1} {Tpunch} {P1} {Tpunch+0.2m} {P2})
FLAG 2240 352 pload
FLAG 2240 432 0
TEXT 32 8 Left 2 ; BATTERY 4S + CONNECTOR (main + precharge contact)       HARNESS 30 cm       PROTECTION: back-to-back N-FETs in the - line       ESC DC LINK + LOAD
TEXT 32 -460 Left 2 ; === 05  PER-CHANNEL PROTECTION: anti-spark soft-start + reverse-polarity block (one channel of topology 04) ===
TEXT 32 -428 Left 2 !.param Vb=15.0 Rbatt=20m Rloop=5.97m Lloop=140n
TEXT 32 -396 Left 2 !.param Tplug=1m Tc=50n Gon={1/0.5m} Rpre=5 Tpre=10m Tmain={Tplug+Pre*Tpre}
TEXT 32 -364 Left 2 !.param Rgate=12k Cmiller=100n      ; soft-start: Iinrush = (Vb - Vplateau)*Cdc/(Rgate*Cmiller) ~ 5 A;  Cgs > Cmiller*(2*Vb/Vto - 1)
TEXT 32 -332 Left 2 !.param Ton=20m P1=126 Tpunch=35m P2=293   ; ESC enables at 20 ms, ramps to 126 W (20,000 RPM), punches to 293 W
TEXT 32 -300 Left 2 !.step param Case list 0 1 2 3 4 5   ; 0 bare XT60 | 1 XT90-S precharge | 2 active FETs, no Cgs (naive) | 3 active FETs + 2.2 uF Cgs | 4 reversed, bare | 5 reversed, active
TEXT 32 -268 Left 2 !.param Pol={if(Case>=4,-1,1)} Pre={if(Case==1,1,0)} Prot={if(Case==2,1,if(Case==3,1,if(Case==5,1,0)))} Cgsx={if(Case==2,1p,2.2u)}
TEXT 32 -236 Left 2 !.model PROT_FET VDMOS(Rd=0.4m Rs=0.2m Vto=2.5 Kp=300 Cgdmax=2n Cgdmin=300p Cgs=6n Cjo=3n Is=10p N=1.05 Rb=2m Vds=40 Ron=1m Qg=80n mfg=Learning)
TEXT 32 -204 Left 2 !.model DZ12 D(Is=1n Rs=5 BV=12 IBV=1m N=1.5)
TEXT 32 -172 Left 2 !.model ESC_BODY D(Is=15p N=1.05 Rs=1.3m)      ; the 6 inverter body diodes, lumped
TEXT 32 -140 Left 2 !.tran 0 45m 0
TEXT 32 -108 Left 2 !.options method=gear      ; trapezoidal integration rang numerically at the punch (5 min, 2 GB); Gear damps it
TEXT 32 -76 Left 2 !.save V(bus) V(g) V(hn) V(s) V(gt) V(hp) V(bt) I(Lpos) I(Lneg) I(Cbulk) I(Ccer) Id(MQ1) Id(MQ2) I(Desc) I(B_PRE) I(B_MAIN) V(pload)
TEXT 32 560 Left 2 !.meas TRAN Ipk_plug MAX I(Lpos) FROM 0 TO 19m
TEXT 32 588 Left 2 !.meas TRAN Imin_plug MIN I(Lpos) FROM 0 TO 19m
TEXT 32 616 Left 2 !.meas TRAN Ipk_main MAX I(Lpos) FROM {Tmain-0.05m} TO {Tmain+1m}
TEXT 32 644 Left 2 !.meas TRAN Vpk_plug MAX V(bus,g) FROM 0 TO 19m
TEXT 32 672 Left 2 !.meas TRAN V_ready AVG V(bus,g) FROM 17m TO 19m
TEXT 32 700 Left 2 !.meas TRAN T90 WHEN V(bus,g)={0.9*Vb} RISE=1
TEXT 32 728 Left 2 !.meas TRAN E_fets INTEG V(g,s)*Id(MQ2)+V(hn,s)*Id(MQ1) FROM 0 TO 19m
TEXT 32 756 Left 2 !.meas TRAN Pk_fet MAX V(g,s)*Id(MQ2) FROM 0 TO 19m
TEXT 32 784 Left 2 !.meas TRAN E_rpre INTEG V(bt,hp)*I(B_PRE) FROM 0 TO 19m
TEXT 32 812 Left 2 !.meas TRAN Irev_avg AVG I(Lpos) FROM 15m TO 19m
TEXT 32 840 Left 2 !.meas TRAN Vgs_on AVG V(gt,s) FROM 28m TO 33m
TEXT 32 868 Left 2 !.meas TRAN Ibat_cruise AVG I(Lpos) FROM 28m TO 33m
TEXT 32 896 Left 2 !.meas TRAN Vbus_cruise AVG V(bus,g) FROM 28m TO 33m
TEXT 32 924 Left 2 !.meas TRAN Pprot_cruise AVG V(g,s)*Id(MQ2)+V(hn,s)*Id(MQ1) FROM 28m TO 33m
TEXT 32 952 Left 2 !.meas TRAN Ibat_punch AVG I(Lpos) FROM 40m TO 45m
TEXT 32 980 Left 2 !.meas TRAN Vbus_punch AVG V(bus,g) FROM 40m TO 45m
TEXT 32 1008 Left 2 !.meas TRAN Pprot_punch AVG V(g,s)*Id(MQ2)+V(hn,s)*Id(MQ1) FROM 40m TO 45m
