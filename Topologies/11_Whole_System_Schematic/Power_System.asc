TEXT 0 -120 Left 3 ;WHOLE POWER SYSTEM: three 24S packs -> three ESC boards -> three motors, and all three packs -> one avionics board
TEXT 0 -72 Left 2 ;Each pack drives its own ESC and motor (independent channels). The avionics board takes power from every pack through a diode-OR.
TEXT 112 280 Left 2 ;24S pack 1 (88.8 V, 30 mOhm)
TEXT 560 32 Left 2 ;8 AWG harness, 1 m
TEXT 1400 452 Left 1 ;encoder
TEXT 112 1080 Left 2 ;24S pack 2 (88.8 V, 30 mOhm)
TEXT 560 832 Left 2 ;8 AWG harness, 1 m
TEXT 1400 1252 Left 1 ;encoder
TEXT 112 1880 Left 2 ;24S pack 3 (88.8 V, 30 mOhm)
TEXT 560 1632 Left 2 ;8 AWG harness, 1 m
TEXT 1400 2052 Left 1 ;encoder
TEXT 1580 2596 Left 2 ;AV_12V -> video / telemetry transmitter
TEXT 1580 2692 Left 2 ;AV_5V -> flight controller + receiver
TEXT 1580 2788 Left 2 ;AV_3V3 -> sensors
TEXT 0 3000 Left 2 ;Phase wires M1_A..M3_C are on this sheet. Inside a block, a node is ESC1:<net>, ESC1:U9:<node> or MOTOR1:<part> (e.g. V(ESC1:+12V), I(MOTOR1:La)); add it to the .save line to keep it.
TEXT 0 3100 Left 2 ; === 10  WHOLE POWER SYSTEM: power-up of all four boards, then every motor commanded from standstill ===
TEXT 0 3132 Left 2 ; Blocks: double-click ESC1..3, MOTOR1..3 or AV1 to open them. Board parts carry their PCB reference designators (see the KiCad entry guide).
TEXT 0 3164 Left 2 !.param KV=38 Ke={60/(2*pi*KV)} Kph={Ke/sqrt(3)} Pp=21 Rph=0.0085 Lph=2.5e-05
TEXT 0 3196 Left 2 !.param Jrot=0.15 Kprop=0.0008113 Bfric=0.01045
TEXT 0 3228 Left 2 !.param Fsw=2e+04 Tsw={1/Fsw} Rdt=150k
TEXT 0 3260 Left 2 !.param Kpi=0.1571 Kii=53.41 Kpw=43.31 Kiw=680.3
TEXT 0 3292 Left 2 !.param W0=0 Iq0=0 Wpunch=50 Imax=60          ; motors start at rest; at Tpunch the speed command steps, current-limited to Imax
TEXT 0 3324 Left 2 !.param Tplug=1m Ten=3m Tpunch=4m Tvtx=4.5m Tfc=5m Tpull=1      ; (Tpull: unused here, packs stay connected)
TEXT 0 3356 Left 2 !.model SMBJ110A D(Is=1p Rs=0.5 N=1 BV=122 IBV=1m)
TEXT 0 3388 Left 2 !.tran 0 6m 0 uic        ; skip the DC solve: packs at 0 V, every board cold
