TEXT -384 0 Left 3 ;1  POWER INPUT + DC LINK
TEXT -168 148 Left 2 ;J1
TEXT -168 180 Left 1 ;AS150 battery (+)
TEXT -380 260 Left 2 ;J1 (-) = GND
TEXT 320 400 Left 2 ;C1-C16: 150 uF 125 V hybrid polymer (bulk)
TEXT 1920 400 Left 2 ;C17-C26: 2.2 uF X7R 1210 at the FETs
TEXT 2976 520 Left 2 ;bus voltage sense -> MCU PA2
TEXT 3360 440 Left 2 ;R6 = NTC on heatsink
TEXT 176 1080 Left 3 ;4  LEG A: half-bridge driver + 4 + 4 FETs + phase current sensor
TEXT 1104 1120 Left 2 ;Q4-Q7 high side, Q8-Q11 low side: IPB065N15N3 (each with its own gate R and 10k pull-down)
TEXT 2208 2536 Left 2 ;J2
TEXT 2208 2568 Left 1 ;motor A
TEXT 2736 1080 Left 3 ;5  LEG B: half-bridge driver + 4 + 4 FETs + phase current sensor
TEXT 3664 1120 Left 2 ;Q12-Q15 high side, Q16-Q19 low side: IPB065N15N3 (each with its own gate R and 10k pull-down)
TEXT 4768 2536 Left 2 ;J3
TEXT 4768 2568 Left 1 ;motor B
TEXT 5296 1080 Left 3 ;6  LEG C: half-bridge driver + 4 + 4 FETs
TEXT 6224 1120 Left 2 ;Q20-Q23 high side, Q24-Q27 low side: IPB065N15N3 (each with its own gate R and 10k pull-down)
TEXT 7328 2536 Left 2 ;J4
TEXT 7328 2568 Left 1 ;motor C
TEXT 240 1136 Left 2 ;VBUS
TEXT -384 2740 Left 3 ;2  ESC AUX SUPPLY 12 V / 0.3 A: U1 LTC7801 synchronous buck, 440 kHz (gate drivers + logic)
TEXT 1300 4300 Left 2 ;Q1/Q2: BSC520N15NS3 / BSC360N15NS3, L1 150 uH, R7 0.1 Ohm sense. Q3 BSP89 pre-regulates DRVCC from the 90 V bus.
TEXT 2576 2740 Left 3 ;3  LOGIC SUPPLIES: U2 LT1763-5, U3 LT1763-3.3
TEXT 3184 3440 Left 1 ;C42 10 nF: DNP
TEXT 3840 3424 Left 1 ;C45 10 nF: DNP
TEXT 4216 2740 Left 3 ;8  MCU U9 STM32G431CBT6 (double-click: FOC firmware model) + connectors
TEXT 6812 2988 Left 2 ;J5
TEXT 6812 3020 Left 1 ;JST GH 3: 1 SIG_EXT (DShot in), 2 TLM_TX, 3 GND
TEXT 6812 3148 Left 2 ;J6
TEXT 6812 3180 Left 1 ;JST GH 6 to AS5047P encoder: +5V GND ENC_CS SCK MISO MOSI
TEXT 6812 3308 Left 2 ;J7
TEXT 6812 3340 Left 1 ;Tag-Connect SWD: +3V3 SWDIO SWCLK NRST GND
TEXT 6300 4000 Left 2 ;ENC_THETA / ENC_OMEGA: the encoder's angle and speed (SPI data on the real board), from the motor block
TEXT 4360 4220 Left 2 ;reset cap
TEXT 4640 4220 Left 2 ;encoder supply (sim)
TEXT -380 4560 Left 2 ;Labels used only for rails (VBUS, +12V, +5V, +3V3), ground and the control signals between the MCU and the legs. Parts without a maker SPICE model are blocks: U7/U8 ACS770, U9 STM32 (double-click to see inside).
TEXT 0 4576 Left 2 ; ESC board, one per motor (block of Power_System.asc). Ports: VBUS, MOT_A, MOT_B, PH_C, ENC_THETA, ENC_OMEGA. Parameters on the top sheet.
