TEXT -384 0 Left 3 ;1  PACK INPUTS: fuse + diode-OR per pack, TVS, bulk
TEXT -216 308 Left 2 ;J1
TEXT -216 340 Left 1 ;pack 1 (+), (-) = GND
TEXT -216 468 Left 2 ;J2
TEXT -216 500 Left 1 ;pack 2 (+), (-) = GND
TEXT -216 628 Left 2 ;J3
TEXT -216 660 Left 1 ;pack 3 (+), (-) = GND
TEXT 80 760 Left 2 ;F1-F3 0.5 A fuses, D1-D3 ES1D diode-OR: any pack keeps the avionics alive
TEXT 680 330 Left 2 ;D4 TVS   C1 33 uF bulk
TEXT 1356 0 Left 3 ;2  12 V / 5 A BUCK: U1 LTC7801, peak current mode, 148 kHz (video/telemetry TX, feeds the 5 V stage)
TEXT 4376 0 Left 3 ;3  12 V OUTPUT: video / telemetry transmitter
TEXT 4812 532 Left 2 ;J4
TEXT 4812 564 Left 1 ;VTX 12 V, (-) = GND
TEXT 4600 874 Left 2 ;C_VTX, B_VTX: transmitter load (sim)
TEXT 4380 480 Left 2 ;F4 PTC 2 A
TEXT 1356 1800 Left 3 ;4  5 V / 3 A BUCK: U2 LT8641, 1 MHz (flight controller + receiver), enabled by 12 V PGOOD
TEXT 3612 2692 Left 2 ;J5
TEXT 3612 2724 Left 1 ;FC + receiver: +5V +5V GND GND
TEXT 3400 2874 Left 2 ;B_FC: FC + receiver load (sim)
TEXT 4376 1800 Left 3 ;5  3.3 V / 0.3 A ULTRALOW-NOISE LDO: U3 LT3045 (sensors), enabled by 5 V PG
TEXT 5972 2548 Left 2 ;J6
TEXT 5972 2580 Left 1 ;sensors: +3V3 GND
