TEXT 32 900 Left 2 ; MECHANICS:  V(te)=torque  V(omega)=rad/s (C_J=inertia)  V(theta)=rotor angle (ideal encoder)  V(the)=electrical angle  V(we)=electrical rad/s
TEXT 32 1160 Left 2 ; FOC CONTROLLER:  speed PI -> iq*,  Clarke + Park of the measured currents,  d/q current PIs + decoupling,  inverse Park/Clarke,  min-max (SVPWM) injection
SYMBOL voltage 64 1240 R0
SYMATTR InstName Vwref
SYMATTR Value PWL(0 0 {Tramp} {Wref})
FLAG 64 1256 wref
FLAG 64 1336 0
SYMBOL voltage 192 1240 R0
SYMATTR InstName Vidref
SYMATTR Value PULSE(0 {-Idstep} {Tstep} 1u 1u {Tdur})
FLAG 192 1256 idref
FLAG 192 1336 0
SYMBOL bv 320 1240 R0
SYMATTR InstName B_IQREF
SYMATTR Value V=limit({Kpw}*(V(wref)-V(omega))+{Kiw}*idt(V(wref)-V(omega)), -{Imax}, {Imax})
FLAG 320 1256 iqref
FLAG 320 1336 0
SYMBOL bv 640 1240 R0
SYMATTR InstName B_IAL
SYMATTR Value V=I(La)
FLAG 640 1256 ial
FLAG 640 1336 0
SYMBOL bv 768 1240 R0
SYMATTR InstName B_IBE
SYMATTR Value V=(I(La)+2*I(Lb))/sqrt(3)
FLAG 768 1256 ibe
FLAG 768 1336 0
SYMBOL bv 896 1240 R0
SYMATTR InstName B_ID
SYMATTR Value V=V(ial)*cos(V(the))+V(ibe)*sin(V(the))
FLAG 896 1256 id
FLAG 896 1336 0
SYMBOL bv 1024 1240 R0
SYMATTR InstName B_IQ
SYMATTR Value V=-V(ial)*sin(V(the))+V(ibe)*cos(V(the))
FLAG 1024 1256 iq
FLAG 1024 1336 0
SYMBOL bv 64 1440 R0
SYMATTR InstName B_VD
SYMATTR Value V={Kpi}*(V(idref)-V(id))+{Kii}*idt(V(idref)-V(id)) - {Dec}*V(we)*{Lph}*V(iq)
FLAG 64 1456 vd
FLAG 64 1536 0
SYMBOL bv 448 1440 R0
SYMATTR InstName B_VQ
SYMATTR Value V={Kpi}*(V(iqref)-V(iq))+{Kii}*idt(V(iqref)-V(iq)) + {Dec}*(V(we)*{Lph}*V(id)+{Kph}*V(omega))
FLAG 448 1456 vq
FLAG 448 1536 0
SYMBOL bv 832 1440 R0
SYMATTR InstName B_VAL
SYMATTR Value V=V(vd)*cos(V(the))-V(vq)*sin(V(the))
FLAG 832 1456 val
FLAG 832 1536 0
SYMBOL bv 960 1440 R0
SYMATTR InstName B_VBE
SYMATTR Value V=V(vd)*sin(V(the))+V(vq)*cos(V(the))
FLAG 960 1456 vbe
FLAG 960 1536 0
SYMBOL bv 1088 1440 R0
SYMATTR InstName B_VA
SYMATTR Value V=V(val)
FLAG 1088 1456 va
FLAG 1088 1536 0
SYMBOL bv 1216 1440 R0
SYMATTR InstName B_VB
SYMATTR Value V=-V(val)/2+sqrt(3)/2*V(vbe)
FLAG 1216 1456 vb
FLAG 1216 1536 0
SYMBOL bv 1344 1440 R0
SYMATTR InstName B_VC
SYMATTR Value V=-V(val)/2-sqrt(3)/2*V(vbe)
FLAG 1344 1456 vc
FLAG 1344 1536 0
SYMBOL bv 64 1640 R0
SYMATTR InstName B_VOFF
SYMATTR Value V={Svm}*(max(max(V(va),V(vb)),V(vc))+min(min(V(va),V(vb)),V(vc)))/2
FLAG 64 1656 voff
FLAG 64 1736 0
SYMBOL voltage 192 1640 R0
SYMATTR InstName Vtri
SYMATTR Value PULSE(0 1 0 {Tsw/2} {Tsw/2} 0 {Tsw})
FLAG 192 1656 tri
FLAG 192 1736 0
SYMBOL bv 448 1640 R0
SYMATTR InstName B_DA
SYMATTR Value V=limit(0.5+(V(va)-V(voff))/V(bus), 0.01, 0.99)
FLAG 448 1656 dua
FLAG 448 1736 0
SYMBOL bv 576 1640 R0
SYMATTR InstName B_HA
SYMATTR Value V=(1+tanh(500*(V(dua)-{dband}-V(tri))))/2
FLAG 576 1656 ha
FLAG 576 1736 0
SYMBOL bv 704 1640 R0
SYMATTR InstName B_LA
SYMATTR Value V=(1+tanh(500*(V(tri)-V(dua)-{dband})))/2
FLAG 704 1656 la
FLAG 704 1736 0
SYMBOL bv 832 1640 R0
SYMATTR InstName B_DB
SYMATTR Value V=limit(0.5+(V(vb)-V(voff))/V(bus), 0.01, 0.99)
FLAG 832 1656 dub
FLAG 832 1736 0
SYMBOL bv 960 1640 R0
SYMATTR InstName B_HB
SYMATTR Value V=(1+tanh(500*(V(dub)-{dband}-V(tri))))/2
FLAG 960 1656 hb
FLAG 960 1736 0
SYMBOL bv 1088 1640 R0
SYMATTR InstName B_LB
SYMATTR Value V=(1+tanh(500*(V(tri)-V(dub)-{dband})))/2
FLAG 1088 1656 lb
FLAG 1088 1736 0
SYMBOL bv 1216 1640 R0
SYMATTR InstName B_DC
SYMATTR Value V=limit(0.5+(V(vc)-V(voff))/V(bus), 0.01, 0.99)
FLAG 1216 1656 duc
FLAG 1216 1736 0
SYMBOL bv 1344 1640 R0
SYMATTR InstName B_HC
SYMATTR Value V=(1+tanh(500*(V(duc)-{dband}-V(tri))))/2
FLAG 1344 1656 hc
FLAG 1344 1736 0
SYMBOL bv 1472 1640 R0
SYMATTR InstName B_LC
SYMATTR Value V=(1+tanh(500*(V(tri)-V(duc)-{dband})))/2
FLAG 1472 1656 lc
FLAG 1472 1736 0
TEXT 32 -560 Left 2 ; === 03  THREE-PHASE INVERTER + SINUSOIDAL PMSM, SENSORED FIELD-ORIENTED CONTROL (FOC) with SVPWM ===
TEXT 32 -528 Left 2 !.param Vbatt=15.2 Rbatt=20m Lwire=100n
TEXT 32 -496 Left 2 !.param Fsw=48k Tsw={1/Fsw} Tdead=100n dband={Tdead/Tsw} Vdrv=10 Rg=4.7
TEXT 32 -464 Left 2 !.param KV=2300 Ke={60/(2*pi*KV)} Kph={Ke/sqrt(3)} Pp=7 Rph=50m Lph=7.5u   ; line-line peak EMF = Ke*w (same KV as 02)
TEXT 32 -432 Left 2 !.param Jrot=5u Kprop=1.15e-8 Bfric=1u
TEXT 32 -400 Left 2 !.param RPMref=14000 Wref={RPMref*2*pi/60} Tramp=120m Imax=30          ; speed command ramps 0 -> 14000 RPM
TEXT 32 -368 Left 2 !.param Fci=3k Kpi={Lph*2*pi*Fci} Kii={Rph*2*pi*Fci}                    ; current PI: zero cancels the R-L pole
TEXT 32 -336 Left 2 !.param Fcw=30 Kt={1.5*Kph} Kpw={Jrot*2*pi*Fcw/Kt} Kiw={Kpw*2*pi*Fcw/4}   ; speed PI
TEXT 32 -304 Left 2 !.param Dec=1 Svm=1 Idstep=5 Tstep=170m Tdur=10m    ; decoupling on, SVPWM on, -5 A d-axis test step
TEXT 32 -272 Left 2 !.model ESC_FET VDMOS(Rd=2.5m Rs=0.5m Vto=1.8 Kp=120 Cgdmax=1.2n Cgdmin=150p Cgs=2.2n Cjo=1.5n Is=5p N=1.05 Rb=4m Tt=20n Vds=30 Ron=3m Qg=30n mfg=Learning)
TEXT 32 -240 Left 2 !.tran 0 250m 0
TEXT 32 -208 Left 2 !.save V(bus) V(pa) V(pb) V(pc) V(n) V(xa) V(xb) V(xc) V(omega) V(rpm) V(te) V(the) V(wref) V(id) V(iq) V(idref) V(iqref) V(vd) V(vq) V(va) V(vb) V(vc) V(voff) V(dua) V(dub) V(duc) I(La) I(Lb) I(Lc) I(Lwire) Id(MAH) Id(MAL) Id(MBH) Id(MBL) Id(MCH) Id(MCL)
TEXT 32 2000 Left 2 !.meas TRAN RPM_final AVG V(rpm) FROM 230m TO 250m
TEXT 32 2028 Left 2 !.meas TRAN Ibat_avg AVG I(Lwire) FROM 230m TO 250m
TEXT 32 2056 Left 2 !.meas TRAN Iph_rms RMS I(La) FROM 230m TO 250m
TEXT 32 2084 Left 2 !.meas TRAN Iph_peak MAX abs(I(La)) FROM 0 TO 250m
TEXT 32 2112 Left 2 !.meas TRAN Iq_avg AVG V(iq) FROM 230m TO 250m
TEXT 32 2140 Left 2 !.meas TRAN Id_avg AVG V(id) FROM 230m TO 250m
TEXT 32 2168 Left 2 !.meas TRAN Iq_max MAX V(iqref) FROM 0 TO 150m
TEXT 32 2196 Left 2 !.meas TRAN Vd_avg AVG V(vd) FROM 230m TO 250m
TEXT 32 2224 Left 2 !.meas TRAN Vq_avg AVG V(vq) FROM 230m TO 250m
TEXT 32 2252 Left 2 !.meas TRAN Te_avg AVG V(te) FROM 230m TO 250m
TEXT 32 2280 Left 2 !.meas TRAN Te_ripple PP V(te) FROM 245m TO 250m
TEXT 32 2308 Left 2 !.meas TRAN Vbus_ripple PP V(bus) FROM 245m TO 250m
TEXT 32 2336 Left 2 !.meas TRAN Id_at_tau AVG V(id) FROM {Tstep+1/(2*pi*Fci)-2u} TO {Tstep+1/(2*pi*Fci)+2u}
TEXT 32 2364 Left 2 !.meas TRAN Id_settled AVG V(id) FROM {Tstep+4m} TO {Tstep+6m}
TEXT 32 2392 Left 2 !.meas TRAN Pin AVG V(bus)*I(Lwire) FROM 230m TO 250m
TEXT 32 2420 Left 2 !.meas TRAN Pmech AVG V(te)*V(omega) FROM 230m TO 250m
TEXT 32 2448 Left 2 !.meas TRAN Pcu AVG {Rph}*(I(La)**2+I(Lb)**2+I(Lc)**2) FROM 230m TO 250m
TEXT 32 2476 Left 2 !.meas TRAN Pfet_hi AVG V(bus,pa)*Id(MAH)+V(bus,pb)*Id(MBH)+V(bus,pc)*Id(MCH) FROM 230m TO 250m
TEXT 32 2504 Left 2 !.meas TRAN Pfet_lo AVG V(pa)*Id(MAL)+V(pb)*Id(MBL)+V(pc)*Id(MCL) FROM 230m TO 250m
TEXT 32 2532 Left 2 !.meas TRAN Efficiency PARAM Pmech/Pin
