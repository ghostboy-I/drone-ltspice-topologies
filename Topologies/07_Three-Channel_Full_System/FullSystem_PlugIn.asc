TEXT 32 600 Left 2 ; MECHANICS 1: V(te)=torque, V(omega)=rad/s (C_J = inertia), prop k*w^2, V(theta)=rotor angle (ideal encoder)
SYMBOL voltage 64 720 R0
SYMATTR InstName Vwref1
SYMATTR Value PWL(0 0 {Tarm} 0 {Tarm+Tramp} {W1})
FLAG 64 736 wref1
FLAG 64 816 0
SYMBOL bv 192 720 R0
SYMATTR InstName B_EN1
SYMATTR Value V=(1+tanh(4*(V(vbf1)-{Vuvlo})))/2*(1+tanh((time-{Tarm})/20u))/2
FLAG 192 736 en1
FLAG 192 816 0
SYMBOL bv 320 720 R0
SYMATTR InstName B_IQREF1
SYMATTR Value V=limit({Kpw}*(V(wref1)-V(omega1))+{Kiw}*idt(V(wref1)-V(omega1),{Iq10/Kiw}),-{Imax},{Imax})
FLAG 320 736 iqref1
FLAG 320 816 0
SYMBOL bv 448 720 R0
SYMATTR InstName B_IAL1
SYMATTR Value V=I(La1)
FLAG 448 736 ial1
FLAG 448 816 0
SYMBOL bv 576 720 R0
SYMATTR InstName B_IBE1
SYMATTR Value V=(I(La1)+2*I(Lb1))/sqrt(3)
FLAG 576 736 ibe1
FLAG 576 816 0
SYMBOL bv 704 720 R0
SYMATTR InstName B_ID1
SYMATTR Value V=V(ial1)*cos(V(the1))+V(ibe1)*sin(V(the1))
FLAG 704 736 id1
FLAG 704 816 0
SYMBOL bv 832 720 R0
SYMATTR InstName B_IQ1
SYMATTR Value V=-V(ial1)*sin(V(the1))+V(ibe1)*cos(V(the1))
FLAG 832 736 iq1
FLAG 832 816 0
SYMBOL bv 960 720 R0
SYMATTR InstName B_VD1
SYMATTR Value V={Kpi}*(0-V(id1))+{Kii}*idt(0-V(id1)) - V(we1)*{Lph}*V(iq1)
FLAG 960 736 vd1
FLAG 960 816 0
SYMBOL bv 1088 720 R0
SYMATTR InstName B_VQ1
SYMATTR Value V={Kpi}*(V(iqref1)-V(iq1))+{Kii}*idt(V(iqref1)-V(iq1),{Rph*Iq10/Kii}) + V(we1)*{Lph}*V(id1)+{Kph}*V(omega1)
FLAG 1088 736 vq1
FLAG 1088 816 0
SYMBOL bv 1216 720 R0
SYMATTR InstName B_VAL1
SYMATTR Value V=V(vd1)*cos(V(the1))-V(vq1)*sin(V(the1))
FLAG 1216 736 val1
FLAG 1216 816 0
SYMBOL bv 1344 720 R0
SYMATTR InstName B_VBE1
SYMATTR Value V=V(vd1)*sin(V(the1))+V(vq1)*cos(V(the1))
FLAG 1344 736 vbe1
FLAG 1344 816 0
SYMBOL bv 1472 720 R0
SYMATTR InstName B_VA1
SYMATTR Value V=V(val1)
FLAG 1472 736 va1
FLAG 1472 816 0
SYMBOL bv 1600 720 R0
SYMATTR InstName B_VB1
SYMATTR Value V=-V(val1)/2+sqrt(3)/2*V(vbe1)
FLAG 1600 736 vb1
FLAG 1600 816 0
