  (text "1  POWER INPUT + DC LINK"
    (exclude_from_sim no)
    (at 20.32 20.32 0)
    (effects
      (font
        (size 3 3)
        (bold yes)
      )
      (justify left)
    )
    (uuid "ada74ece-9fd5-5639-8aba-d613abaf885f")
  )
  (text "J1 AMASS AS150 (anti-spark) on 8 AWG pigtails. The DC link carries 61.7 A rms of ripple at hover: 24 hybrid polymer"
    (exclude_from_sim no)
    (at 20.32 26.67 0)
    (effects
      (font
        (size 1.6 1.6)
      )
      (justify left)
    )
    (uuid "a4b927d7-d499-5214-ae66-6ac24dfa655b")
  )
  (text "caps share it (2.57 A each, rated 3.5 A); the 2.2 µF 250 V ceramics sit right at the FET legs for the switching edges."
    (exclude_from_sim no)
    (at 20.32 29.97 0)
    (effects
      (font
        (size 1.6 1.6)
      )
      (justify left)
    )
    (uuid "23e01559-572a-5243-a531-a7cf500c3926")
  )
  (text "C1-C16, C65-C72: 150 µF 125 V hybrid polymer, ESR ≤ 20 mΩ, ≥ 3.5 A ripple each"
    (exclude_from_sim no)
    (at 50.8 81.28 0)
    (effects
      (font
        (size 1.4 1.4)
      )
      (justify left)
    )
    (uuid "59a2e2ed-5440-50fd-b119-5c3535cf9d3f")
  )
  (text "C17-C26: 2.2 µF X7R 1210 250 V (≈1.1 µF at 90 V), spread over the three legs' VBUS-GND pads"
    (exclude_from_sim no)
    (at 50.8 116.84 0)
    (effects
      (font
        (size 1.4 1.4)
      )
      (justify left)
    )
    (uuid "3c12dac7-6e7e-5a7e-8b61-14648f830eac")
  )
  (text "VBUS_SNS = VBUS × 33k / 1023k: 100.8 V -> 3.25 V at the ADC"
