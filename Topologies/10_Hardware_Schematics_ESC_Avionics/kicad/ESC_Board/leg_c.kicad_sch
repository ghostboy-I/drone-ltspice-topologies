    (exclude_from_sim no)
    (at 20.32 20.32 0)
    (effects
      (font
        (size 3 3)
        (bold yes)
      )
      (justify left)
    )
    (uuid "8ce7271a-8a6f-55f7-af25-1865bfd4cafc")
  )
  (text "Four FETs in parallel per switch, each with its own 10 Ω gate resistor (no gate-loop ringing between them) and 10 kΩ"
    (exclude_from_sim no)
    (at 20.32 26.67 0)
    (effects
      (font
        (size 1.6 1.6)
      )
      (justify left)
    )
    (uuid "61f16b48-0187-5c64-994d-36333f8ba499")
  )
  (text "pull-down (keeps them off while the driver is unpowered). Dead time from the DT resistor: 150 kΩ ≈ 140 ns."
    (exclude_from_sim no)
    (at 20.32 29.97 0)
    (effects
      (font
        (size 1.6 1.6)
      )
      (justify left)
    )
    (uuid "f3fe645e-4775-54d0-a737-5d96a69b5b63")
  )
  (text "J4: motor phase C, 8 AWG lead pad"
    (exclude_from_sim no)
    (at 269.24 111.76 0)
    (effects
      (font
        (size 1.4 1.4)
      )
      (justify left)
    )
    (uuid "f35355af-a8ca-5360-819b-624dc22849f9")
  )
  (text "Q20-Q27: IPB065N15N3 (150 V, 6.5 mΩ, D2PAK). High side: drains on VBUS, sources on PH. Low side: drains on PH, sources on GND."
    (exclude_from_sim no)
    (at 132.08 144.78 0)
    (effects
      (font
        (size 1.4 1.4)
      )
      (justify left)
    )
    (uuid "2ae72041-4e50-5c7d-b133-94058dfd7ad9")
  )
  (text "Layout: the 2.2 µF ceramics across each leg's VBUS-GND, gate resistors at the gates, driver next to its leg."
    (exclude_from_sim no)
    (at 132.08 148.59 0)
    (effects
