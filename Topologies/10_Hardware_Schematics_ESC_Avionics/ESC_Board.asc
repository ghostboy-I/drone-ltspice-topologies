TEXT 32 5520 Left 2 ; === 10  ESC BOARD, one per motor. Cold start of the electronics with the rotor already at hover speed (flying start):
TEXT 32 5554 Left 2 ;     aux 12 V and LDOs soft-start, MCU enables the drivers at Ten, FOC catches the motor; throttle punch at Tpunch ===
TEXT 32 5588 Left 2 ; Parts named V_..., L_HARN, R_CS.., B_..., C_BW.., R_BW.., C_J, C_TH, R_LK.., La/Lb/Lc, R?_M, R_VBF, C_VBF are simulation only.
TEXT 32 5622 Left 2 !.param KV=38 Ke={60/(2*pi*KV)} Kph={Ke/sqrt(3)} Pp=21 Rph=0.0085 Lph=2.5e-05
TEXT 32 5656 Left 2 !.param Jrot=0.15 Kprop=0.0008113 Bfric=0.01045
TEXT 32 5690 Left 2 !.param Fsw=2e+04 Tsw={1/Fsw} Rdt=150k
TEXT 32 5724 Left 2 !.param W0=191 Wpunch=232.2 Iq0=145.2 Imax=210.0
TEXT 32 5758 Left 2 !.param Kpi=0.1571 Kii=53.41 Kpw=43.31 Kiw=680.3
TEXT 32 5792 Left 2 !.param Ten=1.5m Tpunch=7m Tw1=4m Tw2=7m Tp1=10m Tp2=13m
TEXT 32 5826 Left 2 !.ic V(omega)={W0} V(theta)=0 V(SS_AUX)=0 V(+12V)=0 V(+5V)=0 V(+3V3)=0 I(L1)=0   ; electronics cold (soft-start empty), pack connected, rotor at hover
TEXT 32 5860 Left 2 !.tran 0 13m 0
TEXT 32 5894 Left 2 !.save V(VBUS) V(+12V) V(+5V) V(+3V3) V(PH_A) V(PH_B) V(PH_C) V(BST_A) V(TG_A) V(BG_A) V(GAH) V(GAL) V(PWM_A) V(ISNS_A) V(ISNS_B) V(ia) V(ib) V(id) V(iq) V(iqref) V(vd) V(vq) V(dua) V(omega) V(rpm) V(te) V(the) V(wref) V(vbusm) I(La) I(Lb) I(Lc) I(L_HARN) I(C1) I(C17) I(L1) I(D1) I(D2) I(D3) Id(Q4) Id(Q8) Id(Q12) Id(Q16) Id(Q20) Id(Q24) V(SW_AUX) V(FAULT_N) V(DRV_EN)
TEXT 32 5928 Left 2 !.meas TRAN RPM_h AVG V(rpm) FROM {Tw1} TO {Tw2}
TEXT 32 5962 Left 2 !.meas TRAN Iq_h AVG V(iq) FROM {Tw1} TO {Tw2}
TEXT 32 5996 Left 2 !.meas TRAN Id_h AVG V(id) FROM {Tw1} TO {Tw2}
TEXT 32 6030 Left 2 !.meas TRAN Vq_h AVG V(vq) FROM {Tw1} TO {Tw2}
TEXT 32 6064 Left 2 !.meas TRAN Vd_h AVG V(vd) FROM {Tw1} TO {Tw2}
TEXT 32 6098 Left 2 !.meas TRAN Vbus_h AVG V(VBUS) FROM {Tw1} TO {Tw2}
TEXT 32 6132 Left 2 !.meas TRAN Vbus_pp PP V(VBUS) FROM {Tw1} TO {Tw2}
TEXT 32 6166 Left 2 !.meas TRAN Iesc_h AVG I(L_HARN) FROM {Tw1} TO {Tw2}
TEXT 32 6200 Left 2 !.meas TRAN Pin_esc AVG V(VBUS)*I(L_HARN) FROM {Tw1} TO {Tw2}
TEXT 32 6234 Left 2 !.meas TRAN Pshaft AVG {Kprop}*V(omega)**3 FROM {Tw1} TO {Tw2}
TEXT 32 6268 Left 2 !.meas TRAN Pcu AVG {Rph}*(I(La)**2+I(Lb)**2+I(Lc)**2) FROM {Tw1} TO {Tw2}
TEXT 32 6302 Left 2 !.meas TRAN Pfet AVG V(VBUS,PH_A)*Id(Q4)+V(PH_A)*Id(Q8) + V(VBUS,PH_B)*Id(Q12)+V(PH_B)*Id(Q16) + V(VBUS,PH_C)*Id(Q20)+V(PH_C)*Id(Q24) FROM {Tw1} TO {Tw2}
TEXT 32 6336 Left 2 !.meas TRAN Eff_drive PARAM Pshaft/Pin_esc
TEXT 32 6370 Left 2 !.meas TRAN Icap_rms RMS I(C1)+I(C17) FROM {Tw1} TO {Tw2}
TEXT 32 6404 Left 2 !.meas TRAN Iph_rms RMS I(La) FROM {Tw1} TO {Tw2}
TEXT 32 6438 Left 2 !.meas TRAN V12 AVG V(+12V) FROM {Tw1} TO {Tw2}
TEXT 32 6472 Left 2 !.meas TRAN V12_pp PP V(+12V) FROM {Tw1} TO {Tw2}
TEXT 32 6506 Left 2 !.meas TRAN V5 AVG V(+5V) FROM {Tw1} TO {Tw2}
TEXT 32 6540 Left 2 !.meas TRAN V33 AVG V(+3V3) FROM {Tw1} TO {Tw2}
TEXT 32 6574 Left 2 !.meas TRAN I12 AVG I(L1) FROM {Tw1} TO {Tw2}
TEXT 32 6608 Left 2 !.meas TRAN Iboot AVG I(D1)+I(D2)+I(D3) FROM {Tw1} TO {Tw2}
TEXT 32 6642 Left 2 !.meas TRAN Vboot_min MIN V(BST_A,PH_A) FROM {Tw1} TO {Tw2}
TEXT 32 6676 Left 2 !.meas TRAN Vboot_max MAX V(BST_A,PH_A) FROM {Tw1} TO {Tw2}
TEXT 32 6710 Left 2 !.meas TRAN Vgh_max MAX V(GAH,PH_A) FROM {Tw1} TO {Tw2}
TEXT 32 6744 Left 2 !.meas TRAN Vgl_max MAX V(GAL) FROM {Tw1} TO {Tw2}
TEXT 32 6778 Left 2 !.meas TRAN Ia_err_rms RMS V(ia)-I(La) FROM {Tw1} TO {Tw2}
TEXT 32 6812 Left 2 !.meas TRAN Fault_min MIN V(FAULT_N) FROM {Tw1} TO {Tw2}
TEXT 32 6846 Left 2 !.meas TRAN Iq_p AVG V(iq) FROM {Tp1} TO {Tp2}
TEXT 32 6880 Left 2 !.meas TRAN Iesc_p AVG I(L_HARN) FROM {Tp1} TO {Tp2}
TEXT 32 6914 Left 2 !.meas TRAN Vbus_p AVG V(VBUS) FROM {Tp1} TO {Tp2}
TEXT 32 6948 Left 2 !.meas TRAN T_iq90 TRIG V(wref) VAL={W0+1} RISE=1 TARG V(iq) VAL={Iq0+0.9*(Imax-Iq0)} RISE=1
TEXT 32 6982 Left 2 !.meas TRAN V12_min_p MIN V(+12V) FROM {Tpunch} TO {Tp2}
TEXT 32 7016 Left 2 !.meas TRAN T12 WHEN V(+12V)=10.8 RISE=1
TEXT 32 7050 Left 2 !.meas TRAN T5 WHEN V(+5V)=4.5 RISE=1
TEXT 32 7084 Left 2 !.meas TRAN T33 WHEN V(+3V3)=3.0 RISE=1
TEXT 32 7118 Left 2 !.meas TRAN T_iq_catch TRIG V(DRV_EN) VAL=1.65 RISE=1 TARG V(iq) VAL={0.9*Iq0} RISE=1
TEXT 32 7152 Left 2 !.meas TRAN Vboot_en MAX V(BST_A,PH_A) FROM {Ten-0.05m} TO {Ten+0.1m}
TEXT 32 7186 Left 2 !.meas TRAN V12_en_min MIN V(+12V) FROM {Ten} TO {Ten+0.5m}
