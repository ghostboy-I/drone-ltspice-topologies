TEXT 32 1020 Left 2 ; === 10  AVIONICS INPUT SURGE TEST: diode-OR + SMBJ110A + LTC4366-2 surge stopper, 0.35 A load (the 12 V stage at full load) ===
TEXT 32 1054 Left 2 ; Pack 1 jumps to 200 V behind 4 ohm for 20 ms. Pass: VIN_PROT stays at VREG = 115 V; the LTC7801 (150 V) never sees the TVS clamp.
TEXT 32 1088 Left 2 !.param Ts=250m Tsd=20m
TEXT 32 1122 Left 2 !.tran 0 300m 0 startup
TEXT 32 1156 Left 2 !.save V(VIN_AV) V(VIN_PROT) V(GATE_SS) V(VSS_SS) V(TMR_SS) V(VDD_SS) I(D4) Id(Q4)
TEXT 32 1190 Left 2 !.meas TRAN Vprot_pre AVG V(VIN_PROT) FROM {Ts-20m} TO {Ts}
TEXT 32 1224 Left 2 !.meas TRAN Vav_pre AVG V(VIN_AV) FROM {Ts-20m} TO {Ts}
TEXT 32 1258 Left 2 !.meas TRAN T_on WHEN V(VIN_PROT)=80 RISE=1
TEXT 32 1292 Left 2 !.meas TRAN Vav_surge MAX V(VIN_AV) FROM {Ts} TO {Ts+Tsd}
TEXT 32 1326 Left 2 !.meas TRAN Vprot_max MAX V(VIN_PROT) FROM {Ts} TO {Ts+Tsd+5m}
TEXT 32 1360 Left 2 !.meas TRAN Vprot_reg AVG V(VIN_PROT) FROM {Ts+5m} TO {Ts+Tsd}
TEXT 32 1394 Left 2 !.meas TRAN Itvs_max MAX -I(D4) FROM {Ts} TO {Ts+Tsd}
TEXT 32 1428 Left 2 !.meas TRAN Pq4 AVG (V(VIN_AV)-V(VIN_PROT))*Id(Q4) FROM {Ts+5m} TO {Ts+Tsd}
TEXT 32 1462 Left 2 !.meas TRAN Vtmr_max MAX V(TMR_SS)-V(VSS_SS) FROM {Ts} TO {Ts+Tsd}
TEXT 32 1496 Left 2 !.meas TRAN Vprot_post AVG V(VIN_PROT) FROM {Ts+Tsd+20m} TO {Ts+Tsd+28m}
TEXT 32 1530 Left 2 !.model SMBJ110A D(Is=1p Rs=12 N=1 BV=128 IBV=1m)   ; 600 W TVS, 110 V stand-off: VBR 122-135 V, 177 V at 3.4 A (Littelfuse)
