TEXT 32 3720 Left 2 ; === 10  AVIONICS POWER BOARD: three 24S packs -> diode-OR -> 12 V (LTC7801) -> 5 V (LT8641) -> 3.3 V (LT3045) ===
TEXT 32 3754 Left 2 ; Parts named V_..., R_LEAD.., B_..., C_VTX are simulation stimulus/loads, not board parts. Everything else is in Avionics_BOM.csv
TEXT 32 3788 Left 2 !.param Tvtx=6.0m Tfc=6.5m Tw1=6.8m Tw2=7.0m Tpull=7.1m
TEXT 32 3822 Left 2 !.tran 0 8.0m 0 startup
TEXT 32 3856 Left 2 !.save V(VIN_AV) V(PACK1+) V(PACK2+) V(+12V) V(+5V) V(+3V3) V(SW12) V(SW5) V(PG12) V(PG5) V(PG33) V(SS12) V(ITH12) I(L1) I(L2) I(D1) I(D2) I(D3) I(R_LEAD1) I(R_LEAD2) I(R_LEAD3) V(VTX_12V) I(B_VTX) I(B_FC) I(B_SENS)
TEXT 32 3890 Left 2 !.meas TRAN T12 WHEN V(+12V)=10.8 RISE=1
TEXT 32 3924 Left 2 !.meas TRAN T5 WHEN V(+5V)=4.5 RISE=1
TEXT 32 3958 Left 2 !.meas TRAN T33 WHEN V(+3V3)=3.0 RISE=1
TEXT 32 3992 Left 2 !.meas TRAN V12 AVG V(+12V) FROM {Tw1} TO {Tw2}
TEXT 32 4026 Left 2 !.meas TRAN V5 AVG V(+5V) FROM {Tw1} TO {Tw2}
TEXT 32 4060 Left 2 !.meas TRAN V33 AVG V(+3V3) FROM {Tw1} TO {Tw2}
TEXT 32 4094 Left 2 !.meas TRAN Rip12 PP V(+12V) FROM {Tw1} TO {Tw2}
TEXT 32 4128 Left 2 !.meas TRAN Rip5 PP V(+5V) FROM {Tw1} TO {Tw2}
TEXT 32 4162 Left 2 !.meas TRAN Rip33 PP V(+3V3) FROM {Tw1} TO {Tw2}
TEXT 32 4196 Left 2 !.meas TRAN IL1pp PP I(L1) FROM {Tw1} TO {Tw2}
TEXT 32 4230 Left 2 !.meas TRAN IL2pp PP I(L2) FROM {Tw1} TO {Tw2}
TEXT 32 4264 Left 2 !.meas TRAN Vin_av AVG V(VIN_AV) FROM {Tw1} TO {Tw2}
TEXT 32 4298 Left 2 !.meas TRAN Pin AVG V(VIN_AV)*(I(D1)+I(D2)+I(D3)) FROM {Tw1} TO {Tw2}
TEXT 32 4332 Left 2 !.meas TRAN Ppk AVG 88.80000000000001*(I(R_LEAD1)+I(R_LEAD2)+I(R_LEAD3)) FROM {Tw1} TO {Tw2}
TEXT 32 4366 Left 2 !.meas TRAN P12 AVG V(+12V)*I(L1) FROM {Tw1} TO {Tw2}
TEXT 32 4400 Left 2 !.meas TRAN P5 AVG V(+5V)*I(L2) FROM {Tw1} TO {Tw2}
TEXT 32 4434 Left 2 !.meas TRAN Pload AVG V(VTX_12V)*I(B_VTX)+V(+5V)*I(B_FC)+V(+3V3)*I(B_SENS) FROM {Tw1} TO {Tw2}
TEXT 32 4468 Left 2 !.meas TRAN I1 AVG I(D1) FROM {Tw1} TO {Tw2}
TEXT 32 4502 Left 2 !.meas TRAN I2 AVG I(D2) FROM {Tw1} TO {Tw2}
TEXT 32 4536 Left 2 !.meas TRAN I3 AVG I(D3) FROM {Tw1} TO {Tw2}
TEXT 32 4570 Left 2 !.meas TRAN Eff12 PARAM P12/Pin
TEXT 32 4604 Left 2 !.meas TRAN Eff_board PARAM Pload/Ppk
TEXT 32 4638 Left 2 !.meas TRAN V12_pre AVG V(+12V) FROM {Tvtx-0.2m} TO {Tvtx}
TEXT 32 4672 Left 2 !.meas TRAN Dip_vtx MIN V(+12V) FROM {Tvtx} TO {Tvtx+0.3m}
TEXT 32 4706 Left 2 !.meas TRAN V5_pre AVG V(+5V) FROM {Tfc-0.2m} TO {Tfc}
TEXT 32 4740 Left 2 !.meas TRAN Dip_fc MIN V(+5V) FROM {Tfc} TO {Tfc+0.2m}
TEXT 32 4774 Left 2 !.meas TRAN V12_pull MIN V(+12V) FROM {Tpull} TO {Tpull+0.8m}
TEXT 32 4808 Left 2 !.meas TRAN I2_after AVG I(D2) FROM {Tpull+0.5m} TO {Tpull+0.9m}
TEXT 32 4842 Left 2 !.meas TRAN I1_after AVG I(D1) FROM {Tpull+0.5m} TO {Tpull+0.9m}
TEXT 32 4876 Left 2 !.model SMBJ110A D(Is=1p Rs=0.5 N=1 BV=122 IBV=1m)   ; 600 W TVS, 110 V stand-off (approx. datasheet)
