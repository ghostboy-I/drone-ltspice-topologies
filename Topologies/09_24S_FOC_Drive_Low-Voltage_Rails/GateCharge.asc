Version 4
SHEET 1 4000 4000
TEXT 32 96 Left 2 ; ===== GATE CHARGE TEST BENCH (datasheet method): Ig = 10 mA constant, Iload clamped to Vdd by a diode; Qg = Ig * t(Vgs = 12 V) =====
SYMBOL voltage 32 160 R0
SYMATTR InstName Vdd
SYMATTR Value 88.8
FLAG 32 176 vdd
FLAG 32 256 0
SYMBOL diode 192 160 R0
SYMATTR InstName Dclamp
SYMATTR Value DCL
FLAG 208 160 d
FLAG 208 224 vdd
SYMBOL bi 352 160 R0
SYMATTR InstName B_LOAD
SYMATTR Value I=92.4283
FLAG 352 160 0
FLAG 352 240 d
SYMBOL nmos 512 160 R0
SYMATTR InstName M1
SYMATTR Value ESC150
FLAG 560 160 d
FLAG 512 240 g
FLAG 560 256 0
SYMBOL bi 688 160 R0
SYMATTR InstName B_IG
SYMATTR Value I=10m*limit(time/10n,0,1)*(1+tanh(5*(14-V(g))))/2
FLAG 688 160 0
FLAG 688 240 g
SYMBOL res 848 160 R0
SYMATTR InstName Rgs
SYMATTR Value 100Meg
FLAG 864 176 g
FLAG 864 256 0
TEXT 32 600 Left 2 ; === 09  GATE CHARGE of the inverter switch (ESC150 = 4 x 150 V FETs in parallel) at the hover current ===
TEXT 32 632 Left 2 !.model ESC150 VDMOS(Rd=0.0009 Rs=0.00015 Vto=3.5 Kp=800 Cgdmax=4e-09 Cgdmin=8e-11 Cgs=2e-08 Cjo=8e-09 Vj=1 M=0.5 Is=1e-11 N=1.05 Rb=0.001 Tt=50n Vds=150 Qg=2.76e-07 mfg=Learning)
TEXT 32 664 Left 2 !.model DCL D(Is=1p Rs=1m N=1 Tt=0)
TEXT 32 696 Left 2 !.tran 0 60u 0 2n
TEXT 32 728 Left 2 !.save V(g) V(d) Id(M1)
TEXT 32 760 Left 2 !.meas TRAN T_th WHEN V(g)=3.6 RISE=1
TEXT 32 792 Left 2 !.meas TRAN T_pl1 WHEN V(d)={0.9*88.8} FALL=1
TEXT 32 824 Left 2 !.meas TRAN T_pl2 WHEN V(d)=2 FALL=1
TEXT 32 856 Left 2 !.meas TRAN T_12 WHEN V(g)=12 RISE=1
TEXT 32 888 Left 2 !.meas TRAN T_10 WHEN V(g)=10 RISE=1
TEXT 32 920 Left 2 !.meas TRAN Qg12 PARAM 10m*T_12
TEXT 32 952 Left 2 !.meas TRAN Qg10 PARAM 10m*T_10
TEXT 32 984 Left 2 !.meas TRAN Qgd PARAM 10m*(T_pl2-T_pl1)
TEXT 32 1016 Left 2 !.meas TRAN Vplat AVG V(g) FROM T_pl1 TO T_pl2
