TEXT 32 2256 Left 2 ; ===== FOC (topology 03): speed PI -> iq*, Clarke + Park, d/q current PIs + decoupling, inverse Park/Clarke, SVPWM; integrators pre-loaded for hover =====
SYMBOL voltage 32 2320 R0
SYMATTR InstName Vwref
SYMATTR Value PWL(0 {W0} {Tpunch} {W0} {Tpunch+10u} {Wpunch})
FLAG 32 2336 wref
FLAG 32 2416 0
SYMBOL bv 192 2320 R0
SYMATTR InstName B_IQREF
SYMATTR Value V=limit({Kpw}*(V(wref)-V(omega))+{Kiw}*idt(V(wref)-V(omega),{Iq0/Kiw}),-{Imax},{Imax})
FLAG 192 2336 iqref
FLAG 192 2416 0
SYMBOL bv 352 2320 R0
SYMATTR InstName B_IAL
SYMATTR Value V=I(La)
FLAG 352 2336 ial
FLAG 352 2416 0
SYMBOL bv 512 2320 R0
SYMATTR InstName B_IBE
SYMATTR Value V=(I(La)+2*I(Lb))/sqrt(3)
FLAG 512 2336 ibe
FLAG 512 2416 0
SYMBOL bv 672 2320 R0
SYMATTR InstName B_ID
SYMATTR Value V=V(ial)*cos(V(the))+V(ibe)*sin(V(the))
FLAG 672 2336 id
FLAG 672 2416 0
SYMBOL bv 832 2320 R0
SYMATTR InstName B_IQ
SYMATTR Value V=-V(ial)*sin(V(the))+V(ibe)*cos(V(the))
FLAG 832 2336 iq
FLAG 832 2416 0
SYMBOL bv 992 2320 R0
SYMATTR InstName B_VD
SYMATTR Value V={Kpi}*(0-V(id))+{Kii}*idt(0-V(id)) - V(we)*{Lph}*V(iq)
FLAG 992 2336 vd
FLAG 992 2416 0
SYMBOL bv 1152 2320 R0
SYMATTR InstName B_VQ
SYMATTR Value V={Kpi}*(V(iqref)-V(iq))+{Kii}*idt(V(iqref)-V(iq),{Rph*Iq0/Kii}) + V(we)*{Lph}*V(id)+{Kph}*V(omega)
FLAG 1152 2336 vq
FLAG 1152 2416 0
SYMBOL bv 1312 2320 R0
SYMATTR InstName B_VAL
SYMATTR Value V=V(vd)*cos(V(the))-V(vq)*sin(V(the))
FLAG 1312 2336 val
FLAG 1312 2416 0
SYMBOL bv 1472 2320 R0
SYMATTR InstName B_VBE
SYMATTR Value V=V(vd)*sin(V(the))+V(vq)*cos(V(the))
FLAG 1472 2336 vbe
FLAG 1472 2416 0
SYMBOL bv 1632 2320 R0
SYMATTR InstName B_VA
SYMATTR Value V=V(val)
FLAG 1632 2336 va
FLAG 1632 2416 0
SYMBOL bv 1792 2320 R0
SYMATTR InstName B_VB
SYMATTR Value V=-V(val)/2+sqrt(3)/2*V(vbe)
FLAG 1792 2336 vb
FLAG 1792 2416 0
SYMBOL bv 1952 2320 R0
SYMATTR InstName B_VC
SYMATTR Value V=-V(val)/2-sqrt(3)/2*V(vbe)
FLAG 1952 2336 vc
FLAG 1952 2416 0
SYMBOL bv 2112 2320 R0
SYMATTR InstName B_VOFF
SYMATTR Value V=(max(max(V(va),V(vb)),V(vc))+min(min(V(va),V(vb)),V(vc)))/2
FLAG 2112 2336 voff
FLAG 2112 2416 0
SYMBOL res 2272 2320 R0
SYMATTR InstName Rbf
SYMATTR Value 1k
FLAG 2288 2336 bus
FLAG 2288 2416 busf
SYMBOL cap 2432 2320 R0
SYMATTR InstName Cbf
SYMATTR Value 5.30516e-08
FLAG 2448 2320 busf
FLAG 2448 2384 0
SYMBOL voltage 2592 2320 R0
SYMATTR InstName Vtri
SYMATTR Value PULSE(0 1 0 {Tsw/2} {Tsw/2} 0 {Tsw})
FLAG 2592 2336 tri
FLAG 2592 2416 0
SYMBOL bv 2752 2320 R0
SYMATTR InstName B_DA
SYMATTR Value V=limit(0.5+(V(va)-V(voff))/V(busf), 0.01, 0.99)
FLAG 2752 2336 dua
FLAG 2752 2416 0
SYMBOL bv 2912 2320 R0
SYMATTR InstName B_HA
SYMATTR Value V=(1+tanh(500*(V(dua)-{dband}-V(tri))))/2
FLAG 2912 2336 ha
FLAG 2912 2416 0
SYMBOL bv 3072 2320 R0
SYMATTR InstName B_LA
SYMATTR Value V=(1+tanh(500*(V(tri)-V(dua)-{dband})))/2
FLAG 3072 2336 la
FLAG 3072 2416 0
SYMBOL bv 3232 2320 R0
SYMATTR InstName B_DB
SYMATTR Value V=limit(0.5+(V(vb)-V(voff))/V(busf), 0.01, 0.99)
FLAG 3232 2336 dub
FLAG 3232 2416 0
SYMBOL bv 3392 2320 R0
SYMATTR InstName B_HB
SYMATTR Value V=(1+tanh(500*(V(dub)-{dband}-V(tri))))/2
FLAG 3392 2336 hb
FLAG 3392 2416 0
SYMBOL bv 3552 2320 R0
SYMATTR InstName B_LB
SYMATTR Value V=(1+tanh(500*(V(tri)-V(dub)-{dband})))/2
FLAG 3552 2336 lb
FLAG 3552 2416 0
SYMBOL bv 32 2560 R0
SYMATTR InstName B_DC
SYMATTR Value V=limit(0.5+(V(vc)-V(voff))/V(busf), 0.01, 0.99)
FLAG 32 2576 duc
FLAG 32 2656 0
SYMBOL bv 192 2560 R0
SYMATTR InstName B_HC
SYMATTR Value V=(1+tanh(500*(V(duc)-{dband}-V(tri))))/2
FLAG 192 2576 hc
FLAG 192 2656 0
SYMBOL bv 352 2560 R0
SYMATTR InstName B_LC
