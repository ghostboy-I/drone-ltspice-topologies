Version 4
SHEET 1 4000 4000
TEXT 32 96 Left 2 ; ===== AVERAGED SYNCHRONOUS BUCK (state-space averaged switch): <v_sw> = d*Vin, <i_in> = d*iL;  d = comp/(Vin/KFF) =====
SYMBOL voltage 32 160 R0
SYMATTR InstName Vin
SYMATTR Value {Vin}
FLAG 32 176 in
FLAG 32 256 0
SYMBOL bv 192 160 R0
SYMATTR InstName B_SWAVG
SYMATTR Value V=V(d)*V(in)
FLAG 192 176 sw
FLAG 192 256 0
SYMBOL bi 352 160 R0
SYMATTR InstName B_IIN
SYMATTR Value I=V(d)*I(L1)
FLAG 352 160 in
FLAG 352 240 0
SYMBOL bv 512 160 R0
SYMATTR InstName B_D
SYMATTR Value V=V(comp)/(V(in)/10)
FLAG 512 176 d
FLAG 512 256 0
SYMBOL ind 672 160 R0
SYMATTR InstName L1
SYMATTR Value {L}
SYMATTR SpiceLine Rser={DCR}
FLAG 688 176 sw
FLAG 688 256 out
SYMBOL cap 832 160 R0
SYMATTR InstName Cout
SYMATTR Value {C}
SYMATTR SpiceLine Rser={ESR}
FLAG 848 160 out
FLAG 848 224 0
SYMBOL res 992 160 R0
SYMATTR InstName Rload
SYMATTR Value {Rl}
FLAG 1008 176 out
FLAG 1008 256 0
SYMBOL voltage 1152 160 R0
SYMATTR InstName Vinj
SYMATTR Value 0 AC 1
FLAG 1152 176 x
FLAG 1152 256 out
SYMBOL res 1312 160 R0
SYMATTR InstName Rtop
SYMATTR Value {Rtop}
FLAG 1328 176 x
FLAG 1328 256 fb
SYMBOL res 1472 160 R0
SYMATTR InstName R3
SYMATTR Value {R3}
FLAG 1488 176 x
FLAG 1488 256 n3
SYMBOL cap 1632 160 R0
SYMATTR InstName C3
SYMATTR Value {C3}
FLAG 1648 160 n3
FLAG 1648 224 fb
SYMBOL res 1792 160 R0
SYMATTR InstName Rbot
SYMATTR Value 10k
FLAG 1808 176 fb
FLAG 1808 256 0
SYMBOL res 1952 160 R0
SYMATTR InstName R2
SYMATTR Value {R2}
FLAG 1968 176 fb
FLAG 1968 256 n2
SYMBOL cap 2112 160 R0
SYMATTR InstName C1
SYMATTR Value {C1}
FLAG 2128 160 n2
FLAG 2128 224 comp
SYMBOL cap 2272 160 R0
SYMATTR InstName C2
SYMATTR Value {C2}
FLAG 2288 160 fb
FLAG 2288 224 comp
SYMBOL voltage 2432 160 R0
SYMATTR InstName Vref
SYMATTR Value 0.8
FLAG 2432 176 ref
FLAG 2432 256 0
SYMBOL bi 2592 160 R0
SYMATTR InstName B_GM
SYMATTR Value I=1m*(V(ref)-V(fb))
FLAG 2592 160 0
FLAG 2592 240 ea
SYMBOL res 2752 160 R0
SYMATTR InstName Rea
SYMATTR Value 10Meg
FLAG 2768 176 ea
FLAG 2768 256 0
SYMBOL cap 2912 160 R0
SYMATTR InstName Cea
SYMATTR Value 1.59155e-11
FLAG 2928 160 ea
FLAG 2928 224 0
SYMBOL bv 3072 160 R0
SYMATTR InstName B_EAOUT
SYMATTR Value V=V(ea)
FLAG 3072 176 comp
FLAG 3072 256 0
TEXT 32 600 Left 2 ; === 09  LOOP GAIN of the three bucks (T = -V(out)/V(x)).  k: 0/1 AUX12 full/10 % load, 2/3 HV12, 4/5 BEC5 ===
TEXT 32 632 Left 2 !.step param k 0 5 1
TEXT 32 664 Left 2 !.param Vin=table(k,0,86,1,86,2,88,3,88,4,12,5,12)
TEXT 32 696 Left 2 !.param L=table(k,0,0.00022,1,0.00022,2,3.3e-05,3,3.3e-05,4,6.8e-06,5,6.8e-06)
TEXT 32 728 Left 2 !.param DCR=table(k,0,0.45,1,0.45,2,0.015,3,0.015,4,0.015,5,0.015)
TEXT 32 760 Left 2 !.param C=table(k,0,1.1e-05,1,1.1e-05,2,5.28e-05,3,5.28e-05,4,3.96e-05,5,3.96e-05)
TEXT 32 792 Left 2 !.param ESR=table(k,0,0.0025,1,0.0025,2,0.00125,3,0.00125,4,0.00166667,5,0.00166667)
TEXT 32 824 Left 2 !.param Rtop=table(k,0,140000,1,140000,2,140000,3,140000,4,52300,5,52300)
TEXT 32 856 Left 2 !.param R2=table(k,0,59000,1,59000,2,51100,3,51100,4,18700,5,18700)
TEXT 32 888 Left 2 !.param C1=table(k,0,1.8e-09,1,1.8e-09,2,1.8e-09,3,1.8e-09,4,1.8e-09,5,1.8e-09)
TEXT 32 920 Left 2 !.param C2=table(k,0,2.2e-11,1,2.2e-11,2,3.3e-11,3,3.3e-11,4,3.3e-11,5,3.3e-11)
TEXT 32 952 Left 2 !.param R3=table(k,0,2550,1,2550,2,3740,3,3740,4,1430,5,1430)
TEXT 32 984 Left 2 !.param C3=table(k,0,4.7e-10,1,4.7e-10,2,3.9e-10,3,3.9e-10,4,4.7e-10,5,4.7e-10)
TEXT 32 1016 Left 2 !.param Rl=table(k,0,24,1,240,2,2.4,3,24,4,1.66667,5,16.6667)
TEXT 32 1048 Left 2 !.ac dec 200 100 1Meg
TEXT 32 1080 Left 2 !.save V(out) V(x) V(comp) V(d)
