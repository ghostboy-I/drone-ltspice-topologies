Version 4
SHEET 1 3600 2200
TEXT 32 40 Left 2 ; CHANNEL 1:  battery 1 -> harness 1 -> ESC 1 -> motor 1
SYMBOL voltage 64 128 R0
SYMATTR InstName Vbat1
SYMATTR Value PWL(0 0 {Tplug} 0 {Tplug+Tcontact} {Vb1})
FLAG 64 224 bn1
SYMBOL res 96 160 R270
SYMATTR InstName Rint1
SYMATTR Value {Rbatt}
WIRE 64 144 112 144
SYMBOL ind 224 160 R270
SYMATTR InstName Lpos1
SYMATTR Value {Lloop1/2}
SYMATTR SpiceLine Rser={Rloop1/2}
WIRE 192 144 240 144
SYMBOL ind 224 240 R270
SYMATTR InstName Lneg1
SYMATTR Value {Lloop1/2}
SYMATTR SpiceLine Rser={Rloop1/2}
FLAG 240 224 bn1
FLAG 320 224 g1
SYMBOL cap 400 144 R0
SYMATTR InstName Ccer1
SYMATTR Value {Ccer}
SYMATTR SpiceLine Rser=2m Lser=2n
FLAG 416 208 g1
SYMBOL cap 496 144 R0
SYMATTR InstName Cbulk1
SYMATTR Value 470u
SYMATTR SpiceLine Rser={if(Ebulk,30m,1Meg)} Lser=10n
FLAG 512 208 g1
WIRE 320 144 640 144
FLAG 448 144 bus1
SYMBOL bi 640 144 R0
SYMATTR InstName B_INV1
SYMATTR Value I=V(ibus1)
FLAG 640 224 g1
SYMBOL ind 704 128 R0
SYMATTR InstName Lsig1
SYMATTR Value {Lsig}
SYMATTR SpiceLine Rser={Rsig}
FLAG 720 144 g1
FLAG 720 224 0
SYMBOL res 800 128 R0
SYMATTR InstName Rtie1
SYMATTR Value {if(Tie,1m,1G)}
FLAG 816 144 bn1
FLAG 816 224 tie
SYMBOL voltage 1024 128 R0
SYMATTR InstName Viq1
SYMATTR Value PWL(0 0 {Tthr} 0 {Tthr+1m} {Iq1} {Tstep} {Iq1} {Tstep+Trise} {Iq1s})
FLAG 1024 144 iq1
FLAG 1024 224 0
SYMBOL bv 1152 128 R0
SYMATTR InstName B_TH1
SYMATTR Value V=2*pi*{Pp}*{RPM1}/60*time
FLAG 1152 144 th1
FLAG 1152 224 0
SYMBOL bv 1280 128 R0
SYMATTR InstName B_VQ1
SYMATTR Value V={Rph}*V(iq1)+{Kph}*{RPM1}*2*pi/60
FLAG 1280 144 vq1
FLAG 1280 224 0
SYMBOL bv 1408 128 R0
SYMATTR InstName B_VD1
SYMATTR Value V=-{Pp}*{RPM1}*2*pi/60*{Lph}*V(iq1)
FLAG 1408 144 vd1
FLAG 1408 224 0
SYMBOL bv 1536 128 R0
SYMATTR InstName B_IA1
SYMATTR Value V=-V(iq1)*sin(V(th1))
FLAG 1536 144 ia1
FLAG 1536 224 0
SYMBOL bv 1920 128 R0
SYMATTR InstName B_VA1
SYMATTR Value V=V(vd1)*cos(V(th1))-V(vq1)*sin(V(th1))
FLAG 1920 144 va1
FLAG 1920 224 0
SYMBOL bv 1664 128 R0
SYMATTR InstName B_IB1
SYMATTR Value V=-V(iq1)*sin(V(th1)-2*pi/3)
FLAG 1664 144 ib1
FLAG 1664 224 0
SYMBOL bv 2048 128 R0
SYMATTR InstName B_VB1
SYMATTR Value V=V(vd1)*cos(V(th1)-2*pi/3)-V(vq1)*sin(V(th1)-2*pi/3)
FLAG 2048 144 vb1
FLAG 2048 224 0
SYMBOL bv 1792 128 R0
SYMATTR InstName B_IC1
SYMATTR Value V=-V(iq1)*sin(V(th1)-4*pi/3)
FLAG 1792 144 ic1
FLAG 1792 224 0
SYMBOL bv 2176 128 R0
SYMATTR InstName B_VC1
SYMATTR Value V=V(vd1)*cos(V(th1)-4*pi/3)-V(vq1)*sin(V(th1)-4*pi/3)
FLAG 2176 144 vc1
FLAG 2176 224 0
SYMBOL bv 1024 320 R0
SYMATTR InstName B_VOFF1
SYMATTR Value V=(max(max(V(va1),V(vb1)),V(vc1))+min(min(V(va1),V(vb1)),V(vc1)))/2
FLAG 1024 336 voff1
FLAG 1024 416 0
SYMBOL voltage 1152 320 R0
SYMATTR InstName Vtri1
SYMATTR Value PULSE(0 1 {Tph1} {Tsw/2} {Tsw/2} 0 {Tsw})
FLAG 1152 336 tri1
FLAG 1152 416 0
SYMBOL bv 1280 320 R0
SYMATTR InstName B_DA1
SYMATTR Value V=limit(0.5+(V(va1)-V(voff1))/max(V(vbf1),1), 0, 1)
FLAG 1280 336 dua1
FLAG 1280 416 0
SYMBOL bv 1408 320 R0
SYMATTR InstName B_HA1
SYMATTR Value V=(1+tanh(500*(V(dua1)-V(tri1))))/2
FLAG 1408 336 ha1
FLAG 1408 416 0
SYMBOL bv 1536 320 R0
SYMATTR InstName B_DB1
SYMATTR Value V=limit(0.5+(V(vb1)-V(voff1))/max(V(vbf1),1), 0, 1)
FLAG 1536 336 dub1
FLAG 1536 416 0
SYMBOL bv 1664 320 R0
SYMATTR InstName B_HB1
SYMATTR Value V=(1+tanh(500*(V(dub1)-V(tri1))))/2
FLAG 1664 336 hb1
FLAG 1664 416 0
SYMBOL bv 1792 320 R0
SYMATTR InstName B_DC1
SYMATTR Value V=limit(0.5+(V(vc1)-V(voff1))/max(V(vbf1),1), 0, 1)
FLAG 1792 336 duc1
FLAG 1792 416 0
SYMBOL bv 1920 320 R0
SYMATTR InstName B_HC1
SYMATTR Value V=(1+tanh(500*(V(duc1)-V(tri1))))/2
FLAG 1920 336 hc1
FLAG 1920 416 0
SYMBOL bv 2048 320 R0
SYMATTR InstName B_IBUS1
SYMATTR Value V=V(ha1)*V(ia1)+V(hb1)*V(ib1)+V(hc1)*V(ic1)
FLAG 2048 336 ibus1
FLAG 2048 416 0
SYMBOL bv 2176 320 R0
SYMATTR InstName B_VBS1
SYMATTR Value V=V(bus1,g1)
FLAG 2176 336 vbs1
FLAG 2176 416 0
SYMBOL res 2288 320 R0
SYMATTR InstName Rvf1
SYMATTR Value 1k
FLAG 2304 336 vbs1
FLAG 2304 416 vbf1
SYMBOL cap 2400 336 R0
SYMATTR InstName Cvf1
SYMATTR Value {1/(2*pi*1k*Fvf)}
FLAG 2416 336 vbf1
FLAG 2416 400 0
TEXT 1024 40 Left 2 ; ESC 1 + MOTOR 1: phase currents and voltages of the FOC operating point; bus current = sum(h_x * i_x)
