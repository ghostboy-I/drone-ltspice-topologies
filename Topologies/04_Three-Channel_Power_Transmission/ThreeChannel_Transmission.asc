TEXT 32 2292 Left 2 !.meas TRAN Vrip2 PP V(bus2,g2) FROM 6m TO 8m
TEXT 32 2318 Left 2 !.meas TRAN Pload2 AVG V(bus2,g2)*V(ibus2) FROM 6m TO 8m
TEXT 32 2344 Left 2 !.meas TRAN Isig_rms2 RMS I(Lsig2) FROM 6m TO 8m
TEXT 32 2370 Left 2 !.meas TRAN Vplug_pk3 MAX V(bus3,g3) FROM 0 TO 2.5m
