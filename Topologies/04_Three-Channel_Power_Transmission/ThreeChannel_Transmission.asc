TEXT 1024 1160 Left 2 ; ESC 3 + MOTOR 3: phase currents and voltages of the FOC operating point; bus current = sum(h_x * i_x)
TEXT 32 -460 Left 2 ; === 04  THREE-CHANNEL POWER TRANSMISSION: 3 independent 4S batteries -> 3 harnesses -> 3 ESCs -> 3 motors ===
TEXT 32 -428 Left 2 !.param Rbatt=20m Vb1=15.2 Vb2=15.0 Vb3=14.8          ; three packs at slightly different states of charge
TEXT 32 -396 Left 2 !.param Rloop1=2.66m Lloop1=47n  Rloop2=5.97m Lloop2=140n  Rloop3=10.94m Lloop3=770n   ; 10 cm pair, 30 cm pair, 60 cm separated (14 AWG + XT60)
TEXT 32 -364 Left 2 !.param Ccer=10u Rsig=27m Lsig=200n                      ; ESC ceramic; 20 cm 26 AWG signal ground to the flight controller
TEXT 32 -332 Left 2 !.param Fsw=48k Tsw={1/Fsw} Tph1=0 Tph2=7u Tph3=13u       ; three ESCs with unsynchronised PWM carriers
TEXT 32 -300 Left 2 !.param Pp=7 Rph=50m Lph=7.5u Kph={60/(2*pi*2300)/sqrt(3)}  ; same 2300KV 7-pole-pair motor as 02/03
TEXT 32 -268 Left 2 !.param RPM1=14000 Iq1=7.28  RPM2=20000 Iq2=14.6  RPM3=10000 Iq3=3.80   ; prop load at each speed (k w^2)
TEXT 32 -236 Left 2 !.param Iq1s={Iq1} Iq2s={Iq2} Iq3s=25 Tstep=8m Trise=100u              ; motor 3 punches to 25 A at 8 ms
TEXT 32 -204 Left 2 !.param Tplug=10u Tcontact=100n Tthr=3m Fvf=3k     ; ESC bus-voltage measurement bandwidth
TEXT 32 -172 Left 2 !.step param Case list 0 1 2     ; 0 = ceramic only   1 = + 470 uF electrolytic at each ESC   2 = case 1 + battery negatives tied together
TEXT 32 -140 Left 2 !.param Ebulk={if(Case>=1,1,0)} Tie={if(Case==2,1,0)}
TEXT 32 -108 Left 2 !.tran 0 11m 0
TEXT 32 1720 Left 2 !.save V(bus1,g1) V(bus2,g2) V(bus3,g3) V(g1) V(g2) V(g3) V(bn1) V(bn2) V(bn3) I(Lpos1) I(Lpos2) I(Lpos3) I(Lneg1) I(Lneg2) I(Lneg3) I(Ccer1) I(Ccer2) I(Ccer3) I(Cbulk1) I(Cbulk2) I(Cbulk3) I(Lsig1) I(Lsig2) I(Lsig3) V(ibus1) V(ibus2) V(ibus3) V(iq3)
TEXT 32 1746 Left 2 !.meas TRAN Vplug_pk1 MAX V(bus1,g1) FROM 0 TO 2.5m
TEXT 32 1772 Left 2 !.meas TRAN Iplug_pk1 MAX I(Lpos1) FROM 0 TO 2.5m
TEXT 32 1798 Left 2 !.meas TRAN Vbus_avg1 AVG V(bus1,g1) FROM 6m TO 8m
TEXT 32 1824 Left 2 !.meas TRAN Ibat_avg1 AVG I(Lpos1) FROM 6m TO 8m
TEXT 32 1850 Left 2 !.meas TRAN Ibat_rms1 RMS I(Lpos1) FROM 6m TO 8m
TEXT 32 1876 Left 2 !.meas TRAN Iinv_avg1 AVG V(ibus1) FROM 6m TO 8m
TEXT 32 1902 Left 2 !.meas TRAN Iinv_rms1 RMS V(ibus1) FROM 6m TO 8m
TEXT 32 1928 Left 2 !.meas TRAN Icer_rms1 RMS I(Ccer1) FROM 6m TO 8m
TEXT 32 1954 Left 2 !.meas TRAN Ibulk_rms1 RMS I(Cbulk1) FROM 6m TO 8m
TEXT 32 1980 Left 2 !.meas TRAN Vrip1 PP V(bus1,g1) FROM 6m TO 8m
TEXT 32 2006 Left 2 !.meas TRAN Pload1 AVG V(bus1,g1)*V(ibus1) FROM 6m TO 8m
TEXT 32 2032 Left 2 !.meas TRAN Isig_rms1 RMS I(Lsig1) FROM 6m TO 8m
TEXT 32 2058 Left 2 !.meas TRAN Vplug_pk2 MAX V(bus2,g2) FROM 0 TO 2.5m
TEXT 32 2084 Left 2 !.meas TRAN Iplug_pk2 MAX I(Lpos2) FROM 0 TO 2.5m
TEXT 32 2110 Left 2 !.meas TRAN Vbus_avg2 AVG V(bus2,g2) FROM 6m TO 8m
