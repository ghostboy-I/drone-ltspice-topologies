TEXT 32 -240 Left 2 ; === 01  HALF-BRIDGE (one ESC phase leg / synchronous buck) driving a motor ===   Learning model: DC-motor equivalent of one drone motor + 5in prop
TEXT 32 -200 Left 2 !.param Vbatt=15.2 Rbatt=20m Lwire=100n        ; 4S LiPo (3.8 V/cell), pack + wiring
TEXT 32 -168 Left 2 !.param Fsw=24k Tsw={1/Fsw} Tdead=100n db={Tdead/Tsw} Vdrv=10 Rg=4.7
TEXT 32 -136 Left 2 !.param Duty=0.5 Tramp=30m                      ; throttle 50 %, soft-ramped over 30 ms
TEXT 32 -104 Left 2 !.param KV=2300 Ke={60/(2*pi*KV)} Kt={Ke} Rmot=0.1 Lmot=15u   ; ~2205-size 2300KV motor
TEXT 32 -72 Left 2 !.param Jrot=5u Kprop=1.15e-8 Bfric=1u       ; rotor+5in prop inertia [kg m^2], prop torque=Kprop*w^2
TEXT 32 -40 Left 2 !.model ESC_FET VDMOS(Rd=2.5m Rs=0.5m Vto=1.8 Kp=120 Cgdmax=1.2n Cgdmin=150p Cgs=2.2n Cjo=1.5n Is=5p N=1.05 Rb=4m Tt=20n Vds=30 Ron=3m Qg=30n mfg=Learning)
TEXT 32 976 Left 2 !.tran 0 300m 0
TEXT 32 1008 Left 2 !.meas TRAN Ibat_avg AVG I(Lwire) FROM 280m TO 300m
TEXT 32 1032 Left 2 !.meas TRAN Imot_avg AVG I(Lm) FROM 280m TO 300m
TEXT 32 1056 Left 2 !.meas TRAN Imot_ripple PP I(Lm) FROM 295m TO 300m
TEXT 32 1080 Left 2 !.meas TRAN Imot_peak MAX I(Lm)
TEXT 32 1104 Left 2 !.meas TRAN Vbus_ripple PP V(bus) FROM 295m TO 300m
TEXT 32 1128 Left 2 !.meas TRAN RPM_final AVG V(rpm) FROM 280m TO 300m
TEXT 32 1152 Left 2 !.meas TRAN Pin AVG V(bus)*I(Lwire) FROM 280m TO 300m
TEXT 32 1176 Left 2 !.meas TRAN Pmech AVG {Kt}*I(Lm)*V(omega) FROM 280m TO 300m
TEXT 32 1200 Left 2 !.meas TRAN Pcu AVG {Rmot}*I(Lm)**2 FROM 280m TO 300m
TEXT 32 1224 Left 2 !.meas TRAN Pfet_hi AVG V(bus,sw)*Id(Mhi) FROM 280m TO 300m
TEXT 32 1248 Left 2 !.meas TRAN Pfet_lo AVG V(sw)*Id(Mlo) FROM 280m TO 300m
TEXT 32 1272 Left 2 !.meas TRAN Efficiency PARAM Pmech/Pin
TEXT 32 480 Left 2 ; MECHANICAL DOMAIN (analog circuit):  V(omega)=speed [rad/s]   C_J=inertia   B_Tmotor=Kt*I motor torque   B_Tprop=prop drag torque
TEXT 32 720 Left 2 ; PWM: triangle carrier vs throttle. High-side ON when tri < duty-db, low-side ON when tri > duty+db -> the gap is the DEAD TIME
TEXT 32 40 Left 2 ; BATTERY 4S
TEXT 352 40 Left 2 ; DC-LINK CAPS
