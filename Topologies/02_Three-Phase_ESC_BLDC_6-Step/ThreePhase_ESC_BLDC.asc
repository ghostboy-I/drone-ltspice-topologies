TEXT 32 900 Left 2 ; MECHANICS:  V(te)=motor torque  V(omega)=rad/s (C_J=inertia)  V(theta)=rotor angle (integral of omega, C=1F)  V(the)=electrical angle = Pp*theta
SYMBOL voltage 240 1200 R0
SYMATTR InstName Vtri
SYMATTR Value PULSE(0 1 0 {Tsw/2} {Tsw/2} 0 {Tsw})
FLAG 240 1216 tri
FLAG 240 1296 0
SYMBOL voltage 400 1200 R0
SYMATTR InstName Vthrottle
SYMATTR Value PWL(0 0 {Tramp} {Duty})
FLAG 400 1216 duty
FLAG 400 1296 0
SYMBOL bv 560 1200 R0
SYMATTR InstName B_PWMH
SYMATTR Value V=(1+tanh(500*(V(duty)-{db}-V(tri))))/2
FLAG 560 1216 pwmh
FLAG 560 1296 0
SYMBOL bv 720 1200 R0
SYMATTR InstName B_PWML
SYMATTR Value V=(1+tanh(500*(V(tri)-V(duty)-{db})))/2
FLAG 720 1216 pwml
FLAG 720 1296 0
TEXT 32 1136 Left 2 ; PWM: pwmh = high-side chop, pwml = its complement with dead time (used only when Sync=1)
TEXT 32 -520 Left 2 ; === 02  THREE-PHASE ESC (6 half-bridges = 3 legs) + BLDC, 6-STEP TRAPEZOIDAL COMMUTATION with ideal Hall sensors ===
TEXT 32 -488 Left 2 !.param Vbatt=15.2 Rbatt=20m Lwire=100n
TEXT 32 -456 Left 2 !.param Fsw=48k Tsw={1/Fsw} Tdead=100n db={Tdead/Tsw} Vdrv=10 Rg=4.7
TEXT 32 -424 Left 2 !.param Duty=0.5 Tramp=30m
TEXT 32 -392 Left 2 !.param KV=2300 Ke={60/(2*pi*KV)} Pp=7 Rph=50m Lph=7.5u    ; 12N14P 2205-class: line-line 0.1 ohm, 15 uH
TEXT 32 -360 Left 2 !.param Jrot=5u Kprop=1.15e-8 Bfric=1u
TEXT 32 -328 Left 2 !.step param Sync list 0 1     ; 0 = high-side PWM, low side ON (body-diode freewheel)   1 = complementary (synchronous) PWM
TEXT 32 -296 Left 2 !.func trap(x) = limit(6/pi*asin(sin(x)), -1, 1)       ; 120-degree flat-top trapezoid
TEXT 32 -264 Left 2 !.func hi(x) = (1+tanh(100*(sin(x)-0.5)))/2              ; Hall logic: phase drives HIGH during its +flat top
TEXT 32 -232 Left 2 !.func lo(x) = (1+tanh(100*(-sin(x)-0.5)))/2             ; Hall logic: phase drives LOW during its -flat top
TEXT 32 -200 Left 2 !.model ESC_FET VDMOS(Rd=2.5m Rs=0.5m Vto=1.8 Kp=120 Cgdmax=1.2n Cgdmin=150p Cgs=2.2n Cjo=1.5n Is=5p N=1.05 Rb=4m Tt=20n Vds=30 Ron=3m Qg=30n mfg=Learning)
TEXT 32 -168 Left 2 !.tran 0 300m 0
TEXT 32 1360 Left 2 !.save V(bus) V(pa) V(pb) V(pc) V(n) V(xa) V(xb) V(xc) V(omega) V(rpm) V(te) V(the) V(duty) V(tri) I(La) I(Lb) I(Lc) I(Lwire) Id(MAH) Id(MAL) Id(MBH) Id(MBL) Id(MCH) Id(MCL)
TEXT 32 1388 Left 2 !.meas TRAN RPM_final AVG V(rpm) FROM 280m TO 300m
TEXT 32 1416 Left 2 !.meas TRAN Ibat_avg AVG I(Lwire) FROM 280m TO 300m
TEXT 32 1444 Left 2 !.meas TRAN Iph_rms RMS I(La) FROM 280m TO 300m
TEXT 32 1472 Left 2 !.meas TRAN Iph_peak MAX abs(I(La)) FROM 0 TO 300m
TEXT 32 1500 Left 2 !.meas TRAN Te_avg AVG V(te) FROM 280m TO 300m
TEXT 32 1528 Left 2 !.meas TRAN Te_ripple PP V(te) FROM 295m TO 300m
TEXT 32 1556 Left 2 !.meas TRAN Vbus_ripple PP V(bus) FROM 295m TO 300m
TEXT 32 1584 Left 2 !.meas TRAN Pin AVG V(bus)*I(Lwire) FROM 280m TO 300m
TEXT 32 1612 Left 2 !.meas TRAN Pmech AVG V(te)*V(omega) FROM 280m TO 300m
TEXT 32 1640 Left 2 !.meas TRAN Pcu AVG {Rph}*(I(La)**2+I(Lb)**2+I(Lc)**2) FROM 280m TO 300m
TEXT 32 1668 Left 2 !.meas TRAN Pfet_hi AVG V(bus,pa)*Id(MAH)+V(bus,pb)*Id(MBH)+V(bus,pc)*Id(MCH) FROM 280m TO 300m
TEXT 32 1696 Left 2 !.meas TRAN Pfet_lo AVG V(pa)*Id(MAL)+V(pb)*Id(MBL)+V(pc)*Id(MCL) FROM 280m TO 300m
TEXT 32 1724 Left 2 !.meas TRAN Efficiency PARAM Pmech/Pin
TEXT 32 40 Left 2 ; BATTERY 4S
TEXT 352 40 Left 2 ; DC-LINK CAPS
TEXT 880 40 Left 2 ; 3-PHASE INVERTER (3 half-bridge legs)
