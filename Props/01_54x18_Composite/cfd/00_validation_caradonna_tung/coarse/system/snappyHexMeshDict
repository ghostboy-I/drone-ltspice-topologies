FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    blades { type triSurface; file "blades.stl"; }
    disk { type cylinder; point1 (0 0 -0.5715); point2 (0 0 0.3429); radius 1.4287; }
    wake { type cylinder; point1 (0 0 -2.2860); point2 (0 0 0.5715); radius 1.6002; }
    farWake { type cylinder; point1 (0 0 -6.8580); point2 (0 0 1.1430); radius 2.2860; }
    farWake2 { type cylinder; point1 (0 0 -13.7160); point2 (0 0 1.7145); radius 2.6289; }
};

castellatedMeshControls
{
    maxLocalCells 1500000;
    maxGlobalCells 6000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;
    features ( { file "blades.eMesh"; level 8; } );
    refinementSurfaces
    {
        blades { level (7 7); patchInfo { type wall; } }
    }
    resolveFeatureAngle 30;
    refinementRegions
    {
        disk     { mode inside; level 4; }
        wake     { mode inside; level 3; }
        farWake  { mode inside; level 2; }
        farWake2 { mode inside; level 1; }
    }
    insidePoint (0.0123 0.0217 0.5113);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 50;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes false;
    layers { blades { nSurfaceLayers 5; } }
    expansionRatio 1.3;
    firstLayerThickness 0.00025;
    minThickness 7.5e-05;
    nGrow 0;
    featureAngle 130;
    slipFeatureAngle 30;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    #include "meshQualityDict"
}

writeFlags ( scalarLevels layerSets layerFields );
mergeTolerance 1e-6;
